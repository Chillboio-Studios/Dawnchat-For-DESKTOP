<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>com.dawnchat.DawnChatDesktop</id>
  <launchable type="desktop-id">com.dawnchat.DawnChatDesktop.desktop</launchable>
  <name>DawnChat</name>
  <developer id="com.dawnchat">
    <name>Chillboio Studios</name>
    <url>https://www.chillboiostudios.com</url>
  </developer>
  <summary>Open source, user-first chat platform</summary>
  <categories>
    <category>Network</category>
  </categories>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0</project_license>
  <icon type="stock">com.dawnchat.DawnChatDesktop</icon>
  <description>
    <p>DawnChat is an open source, user-first chat platform. Send messages, share
      images, mention users, and join voice channels — all from a native desktop
      application.</p>
  </description>
  <releases>
    <release date="2026-02-14" version="1.2.0">
      <description>
        <p>Features:</p>
        <ul>
          <li>New Branding</li>
          <li>Persist and restore window size and position</li>
        </ul>
        <p>Bug Fixes:</p>
        <ul>
          <li>App Autostart</li>
        </ul>
      </description>
    </release>
    <release date="2025-12-29" version="1.1.12">
      <description>
        <p>Bug fixes:</p>
        <ul>
          <li>Add NixOS compatibility for electron startup</li>
          <li>Correctly load badge count; expose to renderer</li>
          <li>Fix event listener accumulation from rpc client</li>
          <li>Fix macOS tray icon size</li>
          <li>Fix RPC largeImageText</li>
          <li>Use the correct argument for auto start</li>
        </ul>
      </description>
    </release>
  </releases>
  <url type="homepage">https://dawn-chat.com</url>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-info">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
  </content_rating>
  <requires>
    <display_length compare="ge">940</display_length>
    <internet>always</internet>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
</component>
